<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Override with -p:WonderfulCaptchaVersion=x.y.z (e.g. 10.2.4 to reproduce the Alpine font bug). -->
    <WonderfulCaptchaVersion Condition="'$(WonderfulCaptchaVersion)' == ''">10.3.0</WonderfulCaptchaVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WonderfulTools.WonderfulCaptcha" Version="$(WonderfulCaptchaVersion)" />
  </ItemGroup>

</Project>
